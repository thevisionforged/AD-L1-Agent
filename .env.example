# Copy this file to .env and fill in values. NEVER commit .env (it is in .gitignore).
# Built by Samarth Pandey (hack-grp-22).

# OpenAI API key used by the backend only (never sent to the browser). Leave as is to run in offline rule-based mode.
OPENAI_API_KEY=your_key_here

# Chat model for the L1 Virtual Agent, Identity Diagnostics Agent and ops agents.
OPENAI_MODEL=gpt-4.1-mini

# Embedding model for hybrid (BM25 + vector) knowledge base retrieval.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to false to use BM25 keyword retrieval only (no embedding calls).
USE_EMBEDDINGS=true

# Moderation model used to screen user input when online.
OPENAI_MODERATION_MODEL=omni-moderation-latest

# auto = online when a real key is set, offline otherwise; online / offline force a mode.
AGENT_MODE=auto

# Maximum tool calls per user turn (agent loop budget).
MAX_TOOL_CALLS=6

# Maximum output tokens per model call.
MAX_OUTPUT_TOKENS=800

# Per-request timeout in seconds for OpenAI calls.
REQUEST_TIMEOUT_SECONDS=30

# Attempts for 429 / timeout / 5xx before falling back to the offline engine.
MAX_RETRIES=3

# Maximum characters accepted in one user message.
MAX_INPUT_CHARS=2000

# Maximum messages per conversation.
MAX_TURNS_PER_CONVERSATION=20

# ---- Organisation roll-out (docs/ORG_ROLLOUT_GUIDE.md) ----
# Entra sign-in: Directory (tenant) ID of your single-tenant app registration.
ENTRA_TENANT_ID=your_tenant_id_here

# Entra sign-in: Application (client) ID of that app registration.
ENTRA_CLIENT_ID=your_client_id_here

# Entra sign-in: client secret value (Key Vault in production; never commit a real value).
ENTRA_CLIENT_SECRET=your_client_secret_here

# Entra sign-in: must exactly match a Web redirect URI on the app registration.
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# Entra sign-in: random string of at least 32 characters used to sign the session cookie.
SESSION_SECRET=generate_a_random_value_here

# ServiceNow: instance name (yourcompany) or full https URL; leave empty to keep the built-in synthetic ticket store.
SNOW_INSTANCE=

# ServiceNow: integration user with only the itil role (or use SNOW_CLIENT_ID/SNOW_CLIENT_SECRET for OAuth).
SNOW_USERNAME=

# ServiceNow: password of the integration user.
SNOW_PASSWORD=

# ServiceNow (optional): OAuth client ID for the client-credentials grant instead of a password.
SNOW_CLIENT_ID=

# ServiceNow (optional): OAuth client secret.
SNOW_CLIENT_SECRET=

# ServiceNow (optional): exact name of the assignment group for new incidents.
SNOW_ASSIGNMENT_GROUP=

# Teams: Workflows webhook URL of the AD team channel ("Post to a channel when a webhook request is received"); a secret.
TEAMS_WEBHOOK_URL=

# v2: ground answers in live Microsoft Learn docs via the hosted Microsoft Learn MCP server (true/false; read-only, no key).
MS_LEARN_MCP=true

# v2 data source: mock = synthetic directory (hackathon default); live = real Microsoft Graph (needs the 3 GRAPH_* values).
CONNECTOR_MODE=mock

# v2 live mode (optional, only for a separate Graph app; otherwise ENTRA_* is reused): Microsoft Entra tenant ID (see docs/ENTRA_APP_REGISTRATION_AND_ACCESS_GUIDE.md).
GRAPH_TENANT_ID=your_tenant_id_here

# v2 live mode: application (client) ID with admin-consented User.Read.All, GroupMember.Read.All, AuditLog.Read.All.
GRAPH_CLIENT_ID=your_client_id_here

# v2 live mode: client secret of that app (store in Key Vault in production; never commit a real value).
GRAPH_CLIENT_SECRET=your_client_secret_here

# v2 live mode in AUTH_MODE=demo only: the real user principal name whose account the demo reads.
GRAPH_DEMO_UPN=

# Kill switch: set to false to freeze execution of ALL approved actions (agents keep reading and proposing).
ACTIONS_ENABLED=true

# Authentication: demo = user/engineer pickers (hackathon demo); entra = Microsoft Entra ID sign-in built into the app (any host, see ENTRA_* below); easyauth = behind Azure App Service / Container Apps auth.
AUTH_MODE=demo

# Web server bind address (127.0.0.1 = this machine only).
APP_HOST=127.0.0.1

# Web server port (open http://127.0.0.1:<port>/ in the browser).
APP_PORT=8000
